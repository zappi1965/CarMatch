# ─── CarMatch API — Umgebungsvariablen ──────────────────────────────────────
# Kopieren nach apps/api/.env und Werte eintragen.

NODE_ENV=development
PORT=4100

# Datenbank & Queue
DATABASE_URL=postgresql://carmatch:carmatch@localhost:5432/carmatch
# Optional: aktiviert separaten Worker-Prozess (BullMQ, ab v0.2). Ohne REDIS_URL
# laufen Sync-Jobs in-process im API-Server.
REDIS_URL=

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d
# MVP-Admin-Zugang (Admin-Panel). In v0.2 durch Admin-Accounts ersetzt.
ADMIN_TOKEN=

# ─── Inseratsquellen ─────────────────────────────────────────────────────────
# Kommagetrennt: demo | mobile_de | partner_feed | autoscout24
# "demo" ist in NODE_ENV=production gesperrt.
ENABLED_PROVIDERS=demo
# Erlaubt Demo-Daten auch bei NODE_ENV=production (nur Test-Deploy!)
DEMO_MODE=false
# Lädt beim Serverstart Demo-Inserate + Fahrzeugmodelle
SEED_ON_BOOT=false

# mobile.de Search-API (Partnervertrag nötig: https://services.mobile.de)
MOBILE_DE_API_USERNAME=
MOBILE_DE_API_PASSWORD=
MOBILE_DE_API_BASE_URL=https://services.mobile.de/search-api

# AutoScout24: Placeholder — es existiert derzeit keine öffentlich buchbare
# Such-API für Aggregatoren. Adapter bleibt deaktiviert, bis eine
# Partnerlösung vorliegt (siehe AutoScout24Adapter.ts).
AUTOSCOUT_API_KEY=

# Partner-/Händler-Feed (JSON im NormalizedListing-Format)
PARTNER_FEED_URL=

# Technische Fahrzeugdaten (Enrichment) — lizenzierter Anbieter, ab v0.4
VEHICLE_SPECS_API_KEY=

# Geocoding (PLZ/Ort → Koordinaten). Ohne Key: lokale PLZ-Tabelle (DE-Fallback).
MAPS_GEOCODING_API_KEY=

# ─── Push ────────────────────────────────────────────────────────────────────
# true = Versand über Expo Push API; false = Noop (Logs, Entwicklung)
EXPO_PUSH_ENABLED=false

# ─── OAuth ───────────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
APPLE_CLIENT_ID=

# ─── Payments (vorbereitet, MVP ungenutzt) ───────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Betrieb ─────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120
SYNC_INTERVAL_MINUTES=30
